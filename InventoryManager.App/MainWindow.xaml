<Window x:Class="InventoryManager.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:InventoryManager.App.ViewModels"
        Title="Inventory Manager"
        Height="800" Width="1280"
        WindowState="Maximized"
        WindowStartupLocation="CenterScreen">

    

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="200"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- Sidebar -->
        <StackPanel Grid.Column="0" Background="#1F2937">
            <TextBlock Text="Inventory Manager" Foreground="White" FontSize="16" FontWeight="Bold" Margin="16"/>

            <Button Content="Dashboard" Command="{Binding GoToDashboardCommand}" Margin="8,4" Padding="8" HorizontalContentAlignment="Left"/>
            <Button Content="Products" Command="{Binding GoToProductsCommand}" Margin="8,4" Padding="8" HorizontalContentAlignment="Left"/>
            <Button Content="Categories" Command="{Binding GoToCategoriesCommand}" Margin="8,4" Padding="8" HorizontalContentAlignment="Left"/>
            <Button Content="Suppliers" Command="{Binding GoToSuppliersCommand}" Margin="8,4" Padding="8" HorizontalContentAlignment="Left"/>
            <Button Content="Purchases" Command="{Binding GoToPurchasesCommand}" Margin="8,4" Padding="8" HorizontalContentAlignment="Left"/>
            <Button Content="Sales" Command="{Binding GoToSalesCommand}" Margin="8,4" Padding="8" HorizontalContentAlignment="Left"/>
            <Button Content="Reports" Command="{Binding GoToReportsCommand}" Margin="8,4" Padding="8" HorizontalContentAlignment="Left"/>
            <Button Content="Settings" Command="{Binding GoToSettingsCommand}" Margin="8,4" Padding="8" HorizontalContentAlignment="Left"/>
        </StackPanel>

        <!-- Content area -->
        <ContentControl Grid.Column="1" Content="{Binding CurrentView}" Margin="16"/>
    </Grid>
</Window>