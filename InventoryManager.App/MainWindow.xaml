<Window x:Class="InventoryManager.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Inventory Manager"
        Height="720" Width="1200"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource PageBackgroundBrush}">

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="220"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- Sidebar -->
        <Border Grid.Column="0" Background="{StaticResource SidebarBackgroundBrush}">
            <DockPanel>
                <!-- Logo / app name -->
                <StackPanel DockPanel.Dock="Top" Margin="20,24,20,32">
                    <TextBlock Text="📦" FontSize="26" Margin="0,0,0,6"/>
                    <TextBlock Text="Inventory Manager" Foreground="White" FontSize="16" FontWeight="Bold"/>
                    <TextBlock Text="Stock &amp; Sales Control" Foreground="#9CA3AF" FontSize="11" Margin="0,2,0,0"/>
                </StackPanel>

                <!-- Nav items -->
                <StackPanel>
                    <Button Content="📊  Dashboard" Style="{StaticResource SidebarButton}" Command="{Binding GoToDashboardCommand}"/>
                    <Button Content="📦  Products" Style="{StaticResource SidebarButton}" Command="{Binding GoToProductsCommand}"/>
                    <Button Content="🏷️  Categories" Style="{StaticResource SidebarButton}" Command="{Binding GoToCategoriesCommand}"/>
                    <Button Content="🚚  Suppliers" Style="{StaticResource SidebarButton}" Command="{Binding GoToSuppliersCommand}"/>
                    <Button Content="🛒  Purchases" Style="{StaticResource SidebarButton}" Command="{Binding GoToPurchasesCommand}"/>
                    <Button Content="💰  Sales" Style="{StaticResource SidebarButton}" Command="{Binding GoToSalesCommand}"/>
                    <Button Content="📈  Reports" Style="{StaticResource SidebarButton}" Command="{Binding GoToReportsCommand}"/>
                    <Button Content="⚙️  Settings" Style="{StaticResource SidebarButton}" Command="{Binding GoToSettingsCommand}"/>
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- Content area -->
        <ContentControl Grid.Column="1" Content="{Binding CurrentView}"/>
    </Grid>
</Window>