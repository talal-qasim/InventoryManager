<UserControl x:Class="InventoryManager.App.Views.ProductsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:helpers="clr-namespace:InventoryManager.App.Helpers">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="Products" FontSize="22" FontWeight="Bold" Margin="0,0,0,16"/>

        <!-- Search -->
        <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,12">
            <TextBlock Text="Search:" VerticalAlignment="Center" Margin="0,0,8,0"/>
            <TextBox Width="240" Padding="6" helpers:PlaceholderHelper.Placeholder="Search by name or SKU..."
                     Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"/>
        </StackPanel>

        <!-- Add product form, row 1 -->
        <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,0,0,8">
            <TextBox Width="100" Margin="0,0,8,0" Padding="6" helpers:PlaceholderHelper.Placeholder="SKU"
                     Text="{Binding NewSku, UpdateSourceTrigger=PropertyChanged}"/>
            <TextBox Width="180" Margin="0,0,8,0" Padding="6" helpers:PlaceholderHelper.Placeholder="Name"
                     Text="{Binding NewName, UpdateSourceTrigger=PropertyChanged}"/>
            <TextBox Width="200" Margin="0,0,8,0" Padding="6" helpers:PlaceholderHelper.Placeholder="Description"
                     Text="{Binding NewDescription, UpdateSourceTrigger=PropertyChanged}"/>
            <ComboBox Width="160" Margin="0,0,8,0" Padding="6"
                      ItemsSource="{Binding Categories}"
                      SelectedItem="{Binding NewSelectedCategory}"
                      DisplayMemberPath="Name"
                      helpers:SearchableComboBoxHelper.IsSearchable="True"
                      helpers:SearchableComboBoxHelper.Placeholder="Select Category..."/>
            <ComboBox Width="160" Padding="6"
                      ItemsSource="{Binding Suppliers}"
                      SelectedItem="{Binding NewSelectedSupplier}"
                      DisplayMemberPath="Name"
                      helpers:SearchableComboBoxHelper.IsSearchable="True"
                      helpers:SearchableComboBoxHelper.Placeholder="Select Supplier..."/>
        </StackPanel>

        <!-- Add product form, row 2 -->
        <StackPanel Grid.Row="3" Orientation="Horizontal" Margin="0,0,0,8">
            <TextBlock Text="Cost:" VerticalAlignment="Center" Margin="0,0,4,0"/>
            <TextBox Width="80" Margin="0,0,12,0" Padding="6" helpers:PlaceholderHelper.Placeholder="0.00"
                     Text="{Binding NewCostPrice, UpdateSourceTrigger=PropertyChanged}"/>
            <TextBlock Text="Price:" VerticalAlignment="Center" Margin="0,0,4,0"/>
            <TextBox Width="80" Margin="0,0,12,0" Padding="6" helpers:PlaceholderHelper.Placeholder="0.00"
                     Text="{Binding NewSellingPrice, UpdateSourceTrigger=PropertyChanged}"/>
            <TextBlock Text="Reorder Lvl:" VerticalAlignment="Center" Margin="0,0,4,0"/>
            <TextBox Width="60" Margin="0,0,12,0" Padding="6" helpers:PlaceholderHelper.Placeholder="0"
                     Text="{Binding NewReorderLevel, UpdateSourceTrigger=PropertyChanged}"/>
            <TextBlock Text="Unit:" VerticalAlignment="Center" Margin="0,0,4,0"/>
            <TextBox Width="60" Margin="0,0,12,0" Padding="6" helpers:PlaceholderHelper.Placeholder="pcs, kg, etc."
                     Text="{Binding NewUnit, UpdateSourceTrigger=PropertyChanged}"/>
            <Button Content="+ Add Product" Command="{Binding AddProductCommand}" Padding="8,6"/>
        </StackPanel>

        <TextBlock Grid.Row="4" Text="{Binding ErrorMessage}" Foreground="Red" Margin="0,0,0,8"/>

        <!-- Product list -->
        <DataGrid Grid.Row="5"
                  ItemsSource="{Binding Products}"
                  SelectedItem="{Binding SelectedProduct}"
                  AutoGenerateColumns="False"
                  IsReadOnly="True"
                  CanUserAddRows="False">
            <DataGrid.Columns>
                <DataGridTextColumn Header="SKU" Binding="{Binding SKU}" Width="90"/>
                <DataGridTextColumn Header="Name" Binding="{Binding Name}" Width="160"/>
                <DataGridTextColumn Header="Category" Binding="{Binding Category.Name}" Width="120"/>
                <DataGridTextColumn Header="Stock" Binding="{Binding CurrentStock}" Width="70"/>
                <DataGridTextColumn Header="Reorder Lvl" Binding="{Binding ReorderLevel}" Width="90"/>
                <DataGridTextColumn Header="Cost" Binding="{Binding CostPrice, StringFormat=C}" Width="90"/>
                <DataGridTextColumn Header="Price" Binding="{Binding SellingPrice, StringFormat=C}" Width="90"/>
                <DataGridCheckBoxColumn Header="Active" Binding="{Binding IsActive}" Width="70"/>
            </DataGrid.Columns>
        </DataGrid>

        <Button Grid.Row="6" Content="Deactivate Selected" Command="{Binding DeactivateProductCommand}"
                Padding="8,6" Margin="0,8,0,0" HorizontalAlignment="Left"/>
    </Grid>
</UserControl>