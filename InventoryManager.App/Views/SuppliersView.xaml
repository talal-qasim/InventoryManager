<UserControl x:Class="InventoryManager.App.Views.SuppliersView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:helpers="clr-namespace:InventoryManager.App.Helpers">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="Suppliers" FontSize="22" FontWeight="Bold" Margin="0,0,0,16"/>

        <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,8">
            <TextBox Width="160" Margin="0,0,8,0" Padding="6" helpers:PlaceholderHelper.Placeholder="Supplier Name"
                     Text="{Binding NewSupplierName, UpdateSourceTrigger=PropertyChanged}"/>
            <TextBox Width="160" Margin="0,0,8,0" Padding="6" helpers:PlaceholderHelper.Placeholder="Contact Person"
                     Text="{Binding NewContactPerson, UpdateSourceTrigger=PropertyChanged}"/>
            <TextBox Width="140" Margin="0,0,8,0" Padding="6" helpers:PlaceholderHelper.Placeholder="Phone"
                     Text="{Binding NewPhone, UpdateSourceTrigger=PropertyChanged}"/>
            <TextBox Width="180" Margin="0,0,8,0" Padding="6" helpers:PlaceholderHelper.Placeholder="Email"
                     Text="{Binding NewEmail, UpdateSourceTrigger=PropertyChanged}"/>
            <Button Content="+ Add Supplier" Command="{Binding AddSupplierCommand}" Padding="8,6"/>
        </StackPanel>

        <TextBlock Grid.Row="2" Text="{Binding ErrorMessage}" Foreground="Red" Margin="0,0,0,8"/>

        <DataGrid Grid.Row="3"
                  ItemsSource="{Binding Suppliers}"
                  SelectedItem="{Binding SelectedSupplier}"
                  AutoGenerateColumns="False"
                  IsReadOnly="True"
                  CanUserAddRows="False">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Name" Binding="{Binding Name}" Width="160"/>
                <DataGridTextColumn Header="Contact Person" Binding="{Binding ContactPerson}" Width="160"/>
                <DataGridTextColumn Header="Phone" Binding="{Binding Phone}" Width="140"/>
                <DataGridTextColumn Header="Email" Binding="{Binding Email}" Width="*"/>
                <DataGridCheckBoxColumn Header="Active" Binding="{Binding IsActive}" Width="80"/>
            </DataGrid.Columns>
        </DataGrid>

        <Button Grid.Row="4" Content="Deactivate Selected" Command="{Binding DeactivateSupplierCommand}"
                Padding="8,6" Margin="0,8,0,0" HorizontalAlignment="Left"/>
    </Grid>
</UserControl>