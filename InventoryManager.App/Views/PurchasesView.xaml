<UserControl x:Class="InventoryManager.App.Views.PurchasesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:helpers="clr-namespace:InventoryManager.App.Helpers">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="150"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="New Purchase" Style="{StaticResource PageTitle}"/>

        <!-- Supplier + notes -->
        <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,8">
            <TextBlock Text="Supplier:" VerticalAlignment="Center" Margin="0,0,8,0"/>
            <ComboBox Width="200" Margin="0,0,16,0" Padding="6"
                      ItemsSource="{Binding Suppliers}"
                      SelectedItem="{Binding SelectedSupplier}"
                      DisplayMemberPath="Name"
                      helpers:SearchableComboBoxHelper.IsSearchable="True"
                      helpers:SearchableComboBoxHelper.Placeholder="Select Supplier..."/>
            <TextBlock Text="Notes:" VerticalAlignment="Center" Margin="0,0,8,0"/>
            <TextBox Width="240" Padding="6" Text="{Binding Notes, UpdateSourceTrigger=PropertyChanged}"/>
        </StackPanel>

        <!-- Add line form -->
        <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,0,0,8">
            <TextBlock Text="Product:" VerticalAlignment="Center" Margin="0,0,8,0"/>
            <ComboBox Width="200" Margin="0,0,16,0" Padding="6"
                      ItemsSource="{Binding Products}"
                      SelectedItem="{Binding SelectedProductForLine}"
                      DisplayMemberPath="Name"
                      helpers:SearchableComboBoxHelper.IsSearchable="True"
                      helpers:SearchableComboBoxHelper.Placeholder="Select Product..."/>
            <TextBlock Text="Qty:" VerticalAlignment="Center" Margin="0,0,8,0"/>
            <TextBox Width="60" Margin="0,0,16,0" Padding="6"
                     Text="{Binding LineQuantity, UpdateSourceTrigger=PropertyChanged}"/>
            <TextBlock Text="Unit Cost:" VerticalAlignment="Center" Margin="0,0,8,0"/>
            <TextBox Width="80" Margin="0,0,16,0" Padding="6"
                     Text="{Binding LineUnitCost, UpdateSourceTrigger=PropertyChanged}"/>
            <Button Content="+ Add Line" Command="{Binding AddLineCommand}" Padding="8,6"/>
        </StackPanel>

        <TextBlock Grid.Row="3" Text="{Binding ErrorMessage}" Foreground="Red" Margin="0,0,0,8"/>

        <TextBlock Grid.Row="4" Text="Pending Lines:" FontWeight="Bold" Margin="0,0,0,4"/>

        <!-- Pending line items -->
        <DataGrid Grid.Row="5"
                  ItemsSource="{Binding PendingLines}"
                  AutoGenerateColumns="False"
                  IsReadOnly="True"
                  CanUserAddRows="False">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Product" Binding="{Binding ProductName}" Width="*"/>
                <DataGridTextColumn Header="Product Id" Binding="{Binding ProductId}" Width="80"/>
                <DataGridTextColumn Header="Quantity" Binding="{Binding Quantity}" Width="80"/>
                <DataGridTextColumn Header="Unit Cost" Binding="{Binding UnitCost, StringFormat=C}" Width="90"/>
                <DataGridTemplateColumn Header="" Width="80">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <Button Content="Remove"
                                    Command="{Binding DataContext.RemoveLineCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                    CommandParameter="{Binding}"/>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
            </DataGrid.Columns>
        </DataGrid>

        <Button Grid.Row="6" Content="Save Purchase" Command="{Binding SavePurchaseCommand}"
                Padding="8,6" Margin="0,8,0,16" HorizontalAlignment="Left"/>

        <!-- Purchase history -->
        <DataGrid Grid.Row="7"
                  ItemsSource="{Binding Purchases}"
                  AutoGenerateColumns="False"
                  IsReadOnly="True"
                  CanUserAddRows="False">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Reference" Binding="{Binding ReferenceNumber}" Width="180"/>
                <DataGridTextColumn Header="Supplier" Binding="{Binding Supplier.Name}" Width="160"/>
                <DataGridTextColumn Header="Date" Binding="{Binding PurchaseDate, StringFormat='yyyy-MM-dd HH:mm'}" Width="140"/>
                <DataGridTextColumn Header="Total" Binding="{Binding TotalAmount, StringFormat=C}" Width="100"/>
                <DataGridTextColumn Header="Items" Binding="{Binding Items.Count}" Width="60"/>
            </DataGrid.Columns>
        </DataGrid>
    </Grid>
</UserControl>