<UserControl x:Class="InventoryManager.App.Views.ReportsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
    </UserControl.Resources>

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="Reports" Style="{StaticResource PageTitle}"/>
        <TextBlock Grid.Row="0" Text="{Binding ExportMessage}" Foreground="Green" HorizontalAlignment="Right" Margin="0,0,0,16"/>

        <!-- Tab buttons -->
        <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,12">
            <Button Content="Inventory" Command="{Binding ShowInventoryReportCommand}" Padding="10,6" Margin="0,0,4,0"/>
            <Button Content="Sales" Command="{Binding ShowSalesReportCommand}" Padding="10,6" Margin="0,0,4,0"/>
            <Button Content="Low Stock" Command="{Binding ShowLowStockReportCommand}" Padding="10,6" Margin="0,0,4,0"/>
            <Button Content="Stock Movements" Command="{Binding ShowStockMovementReportCommand}" Padding="10,6" Margin="0,0,16,0"/>
            <Button Content="Export to CSV" Command="{Binding ExportCurrentReportCommand}" Padding="10,6" Background="#DCFCE7"/>
        </StackPanel>

        <!-- Date filter (only meaningful for Sales / Stock Movements, but harmless to show always) -->
        <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,0,0,12">
            <TextBlock Text="From:" VerticalAlignment="Center" Margin="0,0,8,0"/>
            <DatePicker Width="130" Margin="0,0,16,0" SelectedDate="{Binding FromDate}"/>
            <TextBlock Text="To:" VerticalAlignment="Center" Margin="0,0,8,0"/>
            <DatePicker Width="130" Margin="0,0,16,0" SelectedDate="{Binding ToDate}"/>
            <Button Content="Apply Filter" Command="{Binding ApplyDateFilterCommand}" Padding="8,6"/>
        </StackPanel>

        <!-- Inventory report -->
        <DataGrid Grid.Row="3" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False"
                  ItemsSource="{Binding InventoryRows}"
                  Visibility="{Binding IsInventoryActive, Converter={StaticResource BoolToVis}}">
            <DataGrid.Columns>
                <DataGridTextColumn Header="SKU" Binding="{Binding SKU}" Width="90"/>
                <DataGridTextColumn Header="Product" Binding="{Binding ProductName}" Width="160"/>
                <DataGridTextColumn Header="Category" Binding="{Binding CategoryName}" Width="120"/>
                <DataGridTextColumn Header="Stock" Binding="{Binding CurrentStock}" Width="70"/>
                <DataGridTextColumn Header="Cost" Binding="{Binding CostPrice, StringFormat=C}" Width="90"/>
                <DataGridTextColumn Header="Inventory Value" Binding="{Binding InventoryValue, StringFormat=C}" Width="120"/>
            </DataGrid.Columns>
        </DataGrid>

        <!-- Sales report -->
        <DataGrid Grid.Row="3" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False"
                  ItemsSource="{Binding SalesRows}"
                  Visibility="{Binding IsSalesActive, Converter={StaticResource BoolToVis}}">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Date" Binding="{Binding SaleDate, StringFormat='yyyy-MM-dd HH:mm'}" Width="140"/>
                <DataGridTextColumn Header="Product" Binding="{Binding ProductName}" Width="160"/>
                <DataGridTextColumn Header="Quantity" Binding="{Binding Quantity}" Width="80"/>
                <DataGridTextColumn Header="Revenue" Binding="{Binding Revenue, StringFormat=C}" Width="100"/>
                <DataGridTextColumn Header="Profit" Binding="{Binding Profit, StringFormat=C}" Width="100"/>
            </DataGrid.Columns>
        </DataGrid>

        <!-- Low stock report -->
        <DataGrid Grid.Row="3" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False"
                  ItemsSource="{Binding LowStockRows}"
                  Visibility="{Binding IsLowStockActive, Converter={StaticResource BoolToVis}}">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Product" Binding="{Binding ProductName}" Width="160"/>
                <DataGridTextColumn Header="Current Stock" Binding="{Binding CurrentStock}" Width="100"/>
                <DataGridTextColumn Header="Reorder Level" Binding="{Binding ReorderLevel}" Width="100"/>
                <DataGridTextColumn Header="Supplier" Binding="{Binding SupplierName}" Width="*"/>
            </DataGrid.Columns>
        </DataGrid>

        <!-- Stock movement report -->
        <DataGrid Grid.Row="3" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False"
                  ItemsSource="{Binding MovementRows}"
                  Visibility="{Binding IsStockMovementActive, Converter={StaticResource BoolToVis}}">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Date" Binding="{Binding MovementDate, StringFormat='yyyy-MM-dd HH:mm'}" Width="140"/>
                <DataGridTextColumn Header="Product" Binding="{Binding Product.Name}" Width="160"/>
                <DataGridTextColumn Header="Type" Binding="{Binding MovementType}" Width="110"/>
                <DataGridTextColumn Header="Qty" Binding="{Binding Quantity}" Width="60"/>
                <DataGridTextColumn Header="Prev Stock" Binding="{Binding PreviousStock}" Width="80"/>
                <DataGridTextColumn Header="New Stock" Binding="{Binding NewStock}" Width="80"/>
            </DataGrid.Columns>
        </DataGrid>
    </Grid>
</UserControl>