<UserControl x:Class="InventoryManager.App.Views.ReportsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="Stock Movement History (temporary — full Reports come in Milestone 13)"
                   FontSize="18" FontWeight="Bold" Margin="0,0,0,16"/>

        <DataGrid Grid.Row="1"
                  ItemsSource="{Binding Movements}"
                  AutoGenerateColumns="False"
                  IsReadOnly="True"
                  CanUserAddRows="False">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Date" Binding="{Binding MovementDate, StringFormat='yyyy-MM-dd HH:mm'}" Width="140"/>
                <DataGridTextColumn Header="Product" Binding="{Binding Product.Name}" Width="160"/>
                <DataGridTextColumn Header="Type" Binding="{Binding MovementType}" Width="110"/>
                <DataGridTextColumn Header="Qty" Binding="{Binding Quantity}" Width="60"/>
                <DataGridTextColumn Header="Prev Stock" Binding="{Binding PreviousStock}" Width="80"/>
                <DataGridTextColumn Header="New Stock" Binding="{Binding NewStock}" Width="80"/>
                <DataGridTextColumn Header="Notes" Binding="{Binding Notes}" Width="*"/>
            </DataGrid.Columns>
        </DataGrid>
    </Grid>
</UserControl>