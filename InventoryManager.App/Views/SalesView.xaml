<UserControl x:Class="InventoryManager.App.Views.SalesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:helpers="clr-namespace:InventoryManager.App.Helpers">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="150"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="New Sale" FontSize="22" FontWeight="Bold" Margin="0,0,0,12"/>

        <!-- Notes -->
        <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,8">
            <TextBlock Text="Notes:" VerticalAlignment="Center" Margin="0,0,8,0"/>
            <TextBox Width="300" Padding="6" Text="{Binding Notes, UpdateSourceTrigger=PropertyChanged}"/>
        </StackPanel>

        <!-- Add line form -->
        <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,0,0,8">
            <TextBlock Text="Product:" VerticalAlignment="Center" Margin="0,0,8,0"/>
            <ComboBox Width="200" Margin="0,0,16,0" Padding="6"
                      ItemsSource="{Binding Products}"
                      SelectedItem="{Binding SelectedProductForLine}"
                      DisplayMemberPath="Name"/>
            <TextBlock Text="Qty:" VerticalAlignment="Center" Margin="0,0,8,0"/>
            <TextBox Width="60" Margin="0,0,16,0" Padding="6"
                     Text="{Binding LineQuantity, UpdateSourceTrigger=PropertyChanged}"
                     helpers:PlaceholderHelper.Placeholder="Qty"/>
            <TextBlock Text="Unit Price:" VerticalAlignment="Center" Margin="0,0,8,0"/>
            <TextBox Width="80" Margin="0,0,16,0" Padding="6"
                     Text="{Binding LineUnitPrice, UpdateSourceTrigger=PropertyChanged}"
                     helpers:PlaceholderHelper.Placeholder="Price"/>
            <Button Content="+ Add Line" Command="{Binding AddLineCommand}" Padding="8,6"/>
        </StackPanel>

        <TextBlock Grid.Row="3" Text="{Binding ErrorMessage}" Foreground="Red" Margin="0,0,0,8"/>

        <!-- Pending line items -->
        <DataGrid Grid.Row="4"
                  ItemsSource="{Binding PendingLines}"
                  AutoGenerateColumns="False"
                  IsReadOnly="True"
                  CanUserAddRows="False">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Product" Binding="{Binding ProductName}" Width="*"/>
                <DataGridTextColumn Header="Product Id" Binding="{Binding ProductId}" Width="80"/>
                <DataGridTextColumn Header="Quantity" Binding="{Binding Quantity}" Width="80"/>
                <DataGridTextColumn Header="Unit Price" Binding="{Binding UnitPrice, StringFormat=C}" Width="90"/>
                <DataGridTemplateColumn Header="" Width="80">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <Button Content="Remove"
                                    Command="{Binding DataContext.RemoveLineCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                    CommandParameter="{Binding}"/>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
            </DataGrid.Columns>
        </DataGrid>

        <Button Grid.Row="5" Content="Save Sale" Command="{Binding SaveSaleCommand}"
                Padding="8,6" Margin="0,8,0,16" HorizontalAlignment="Left"/>

        <!-- Sale history -->
        <DataGrid Grid.Row="6"
                  ItemsSource="{Binding Sales}"
                  AutoGenerateColumns="False"
                  IsReadOnly="True"
                  CanUserAddRows="False">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Reference" Binding="{Binding ReferenceNumber}" Width="180"/>
                <DataGridTextColumn Header="Date" Binding="{Binding SaleDate, StringFormat='yyyy-MM-dd HH:mm'}" Width="140"/>
                <DataGridTextColumn Header="Total" Binding="{Binding TotalAmount, StringFormat=C}" Width="100"/>
                <DataGridTextColumn Header="Items" Binding="{Binding Items.Count}" Width="60"/>
            </DataGrid.Columns>
        </DataGrid>
    </Grid>
</UserControl>